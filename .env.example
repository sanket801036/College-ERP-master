SECRET_KEY=change-me-in-production
DEBUG=True

DB_NAME=college_erp
DB_USER=postgres
DB_PASSWORD=your-postgres-password
DB_HOST=localhost
DB_PORT=5433

# Uploads. Leave the bucket name blank and profile photos stay on the local
# disk, which is fine locally and under docker-compose. On Render the disk does
# not survive a redeploy, so set these to keep them.
AWS_STORAGE_BUCKET_NAME=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_REGION_NAME=
